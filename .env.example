# Docker Compose 환경변수 예시
# 이 파일을 .env로 복사해서 사용: cp .env.example .env

# --- DB ---
DB_PASSWORD=password

# --- 인증 ---
# 운영에서는 반드시 교체 (32자 이상). AWS 배포 시 SSM Parameter Store(SecureString) 로 관리 권장
JWT_SECRET=baseball-recommend-jwt-secret-key-for-docker-dev-only-min-32-chars!!

# --- CORS ---
# 백엔드가 허용할 프론트엔드 오리진(콤마 구분).
# 운영에서는 CloudFront 도메인만 지정할 것 (예: https://d123abc.cloudfront.net)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- AI (선택) ---
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
